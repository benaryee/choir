# =============================================================================
# ChoirParts — Docker deployment environment
# Copy this file and fill in secrets before running docker compose up.
# =============================================================================

# ---------------------------------------------------------------------------
# General
# Set PUBLIC_BASE_URL to the external URL where the app is reachable.
# This URL is embedded in file links returned by the API, so the browser
# must be able to reach it. Use http://localhost for local Docker testing.
# ---------------------------------------------------------------------------
DATA_DIR=/data
PUBLIC_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# Job queue — Celery + Redis (both pre-wired to the redis service)
# ---------------------------------------------------------------------------
USE_CELERY=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Storage — local disk (shared Docker volume) or S3
# Set STORAGE_BACKEND=s3 and fill in the S3 block below for cloud deployments.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

S3_BUCKET=choirparts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# OMR — Audiveris (pre-installed in the container at /opt/audiveris)
# ---------------------------------------------------------------------------
AUDIVERIS_CMD=/opt/audiveris/bin/Audiveris
OMR_CONFIDENCE_THRESHOLD=0.5
OMR_MANUAL_THRESHOLD=0.4

# ---------------------------------------------------------------------------
# OMR — GPT-4o Vision fallback
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Audio synthesis
# FluidSynth and FFmpeg are pre-installed; the soundfont comes from the
# fluid-soundfont-gm package (FluidR3_GM.sf2, General MIDI — covers choir).
# ---------------------------------------------------------------------------
SOUNDFONT_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2
FLUIDSYNTH_CMD=fluidsynth
FFMPEG_CMD=ffmpeg
