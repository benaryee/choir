# ChoirParts backend configuration

# --- General ---
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000

# --- Job queue ---
# When true, dispatch jobs to Celery (requires Redis + a running worker).
# When false, jobs run in an in-process thread pool (good for local dev).
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
# STORAGE_BACKEND = "local" or "s3"
STORAGE_BACKEND=local
S3_BUCKET=choirparts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom endpoint (e.g. MinIO)
S3_ENDPOINT_URL=

# --- OMR: Audiveris ---
# Path to the Audiveris launcher script or jar. Leave empty to skip Audiveris.
AUDIVERIS_CMD=
# Confidence below which the GPT-4o Vision fallback is used (0..1).
# A successful Audiveris transcription scores ~0.6, so keep this below 0.6 to
# trust Audiveris and skip the (weaker) Vision fallback. Raise it to always
# cross-check with GPT-4o Vision.
OMR_CONFIDENCE_THRESHOLD=0.5
# Confidence below which manual correction is requested (0..1).
OMR_MANUAL_THRESHOLD=0.4

# --- OMR: GPT-4o Vision fallback ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# --- Audio synthesis (later milestone) ---
SOUNDFONT_PATH=
FLUIDSYNTH_CMD=fluidsynth
FFMPEG_CMD=ffmpeg
